# ─── Banco de Dados ──────────────────────────────────────────────────────────
# Formato: postgresql://usuario:senha@host:5432/nome_do_banco
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/pa_cms

# ─── Payload ─────────────────────────────────────────────────────────────────
# Chave secreta para assinar tokens JWT — mínimo 32 caracteres
PAYLOAD_SECRET=troque_por_uma_string_aleatoria_longa_aqui

# ─── URL pública do CMS ───────────────────────────────────────────────────────
# Em desenvolvimento: http://localhost:3000
# Em produção: URL do Cloud Run
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── CORS ────────────────────────────────────────────────────────────────────
# URL do frontend que pode consumir a API (separar por vírgula se houver mais de um)
CORS_ORIGIN=http://localhost:5173

# ─── Google Cloud Storage ────────────────────────────────────────────────────
# Bucket público para imagens e assets gerais
GCS_BUCKET_MEDIA=pa-cms-media

# Bucket privado apenas para currículos
GCS_BUCKET_RESUMES=pa-cms-resumes

# Credenciais de serviço (em produção, usar Secret Manager em vez de arquivo)
GOOGLE_APPLICATION_CREDENTIALS=./gcs-credentials.json

# ─── E-mail (Serviço de Envio - Resend SMTP) ───────────────────────────────
# Chave de acesso do Resend (ex: re_xxxxxxxxxxxxxxxxx)
RESEND_API_KEY=
# E-mail que o site vai usar para enviar (deve ser do domínio verificado no Resend)
RESEND_FROM=no-reply@dominio.com.br
# Nome que aparecerá como remetente
RESEND_FROM_NAME=PA Consultoria - Carreiras

# ─── E-mail (Fallback via Nodemailer / SMTP genérico) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=PA Consultoria <noreply@agropa.com.br>

# ─── Destinatários das Notificações ─────────────────────────────────────────
# Recebe as mensagens do formulário de contato
CONTACT_RECIPIENT=contato@dominio.com.br

# Recebe as candidaturas de vagas (com currículos em anexo)
CAREER_RECIPIENT=rh@dominio.com.br

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development

{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "run": {
          "serviceId": "pa-cms",
          "region": "us-central1"
        }
      },
      {
        "source": "/admin/**",
        "run": {
          "serviceId": "pa-cms",
          "region": "us-central1"
        }
      },
      {
        "source": "/api",
        "run": {
          "serviceId": "pa-cms",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "pa-cms",
          "region": "us-central1"
        }
      },
      {
        "source": "/_next/**",
        "run": {
          "serviceId": "pa-cms",
          "region": "us-central1"
        }
      },
      {
        "source": "/media/**",
        "run": {
          "serviceId": "pa-cms",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
